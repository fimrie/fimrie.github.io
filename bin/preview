#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
ruby_series=$(< .ruby-version)

# Prefer the project's versioned Homebrew Ruby over macOS or an old conda Ruby.
if command -v brew >/dev/null 2>&1; then
  ruby_prefix=$(brew --prefix "ruby@${ruby_series}" 2>/dev/null || true)
  if [[ -x "$ruby_prefix/bin/ruby" ]]; then
    export PATH="$ruby_prefix/bin:$PATH"
  fi
fi

if ! command -v ruby >/dev/null 2>&1 ||
   ! ruby -e 'exit(RUBY_VERSION.start_with?(ARGV.fetch(0) + ".") ? 0 : 1)' "$ruby_series"; then
  printf 'Ruby %s is required. Follow the local setup in README.md.\n' "$ruby_series" >&2
  exit 1
fi

exec bundle exec jekyll serve --host 127.0.0.1 --livereload "$@"
